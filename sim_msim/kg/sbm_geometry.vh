// ============================================================================
// @file      sbm_geometry.vh
// @brief     SBM 全链路几何参数「单一真源」(Single Source of Truth)
// @details
//   ┌──────────────────────────────────────────────────────────────────────┐
//   │  只允许修改「用户输入区」的 4 个宏。其余全部自动派生，禁止手改。      │
//   └──────────────────────────────────────────────────────────────────────┘
//
//   为什么需要本文件：
//     IMG_W/IMG_H 取决于相机，属于易变参数。若各模块各自硬编 WC=313、
//     CELLS=97969、CHUNK=3652、位宽 [14:0] 之类的「手算常量」，换一次相机
//     就要在十几处同步改数，漏改一处即产生**静默**的地址错位或位置丢弃
//     （不会报错，只是匹配结果变差），排查成本极高。
//     本文件把「相机原始分辨率」作为唯一输入，其余几何量与位宽全部由公式
//     派生；各 RTL 模块内部再由 IMG_W/IMG_H/T 二次派生自己的位宽，
//     从而做到「改一处、全链路自动跟随」。
//
//   级联关系（务必理解）：
//     级0 (Level-0) = 相机原始帧经**边缘复制填充**后的尺寸，供 alg1 高斯 /
//                     alg2 Sobel / alg3 量化使用。
//     级1 (Level-1) = 级0 二倍降采样后的金字塔层，供 alg8 扩散 /
//                     alg9 响应图落盘 / alg11 累加 / alg13 NMS 使用。
//     约束链：级1 须为 T 的整数倍（与 line2Dup.cpp linearize() 的断言同口径），
//             且 WC=级1宽/T 须为 8 的整数倍（alg9 64bit AXI 写地址 8B 对齐：
//             地址 = ...+band*WC, 若 WC 为奇数则奇 band 落奇地址, AXI 协议违规）
//             ⇒ 级1 须为 8T 的整数倍 ⇒ 级0 须为 16T 的整数倍
//             ⇒ 级0 = ceil(CAM/(16T)) * (16T)。
//     例：相机 5000×5000 ⇒ 级0 5120×5120 ⇒ 级1 2560×2560 ⇒ WC=HC=320。
//     填充由采集前端（或 alg1 上游的 border-replicate 逻辑）完成，本文件
//     只负责把「需要填充到多少」算出来，不需要人工换算。
//
// @note  本文件被多个模块 include，已加 ifndef 保护，可重复包含。
// @note  宏均加 SBM_ 前缀以避免全局命名空间冲突。
// @author    WorkBuddy
// @date      2026-08-14
// ============================================================================
`ifndef SBM_GEOMETRY_VH
`define SBM_GEOMETRY_VH

// ============================================================================
//                        ↓↓↓  用户输入区（只改这里）  ↓↓↓
// ============================================================================

/// 相机原始帧宽（级0，填充前）。换相机只改这一行。
`define SBM_CAM_W       5000
/// 相机原始帧高（级0，填充前）。换相机只改这一行。
`define SBM_CAM_H       5000
/// line2Dup 的 T（块边长）。必须是 2 的幂（8 为 C++ 默认值）。
`define SBM_T           8
/// alg11 累加通道数（吞吐/资源权衡，与几何无关，可独立调整）。
`define SBM_LANES       24
/// 单帧最大特征数（AXI-Lite 特征 FIFO 深度）。
`define SBM_FEAT_MAX    64
/// 响应图线性内存在 DDR 中的基址（8 方向 × T×T 块 × CELLS 字节连续排布）。
`define SBM_RESP_BASE   32'h0800_0000

// ============================================================================
//                     ↓↓↓  以下全部自动派生，禁止手改  ↓↓↓
// ============================================================================

/// 向上对齐宏：ALIGN(v,a) = ceil(v/a)*a
`define SBM_ALIGN(v, a)  ((((v) + (a) - 1) / (a)) * (a))

/// 向上取整除宏：CEILDIV(v,a) = ceil(v/a)
`define SBM_CEILDIV(v, a)  (((v) + (a) - 1) / (a))

/// 位宽派生宏：SBM_W(n) = 能表示 0..n-1 所需位宽（n<2 时钳到 1，避免 0 宽度声明）。
/// 计数器若需要取到 n 本身（如 band_cur 末尾自增到 HC），请用 `SBM_W(n+1)`。
`define SBM_W(n)  (((n) < 2) ? 1 : $clog2(n))

/// 级0 对齐尺寸：须为 16T 的整数倍（保证降采样后级1 为 8T 的整数倍：
/// 级1 既满足 T 整除，又满足 WC=级1/T 被 8 整除 → alg9 64bit AXI 写 8B 对齐）
`define SBM_L0_W        `SBM_ALIGN(`SBM_CAM_W, (16 * `SBM_T))
`define SBM_L0_H        `SBM_ALIGN(`SBM_CAM_H, (16 * `SBM_T))

/// 级1 尺寸（金字塔第 1 层 = 级0 / 2），恒为 8T 的整数倍（T 整除 + WC 8 对齐）
`define SBM_IMG_W       (`SBM_L0_W / 2)
`define SBM_IMG_H       (`SBM_L0_H / 2)

/// 级1 单元网格（linearize 后的线性内存维度）
`define SBM_WC          (`SBM_IMG_W / `SBM_T)
`define SBM_HC          (`SBM_IMG_H / `SBM_T)
`define SBM_CELLS       (`SBM_WC * `SBM_HC)

/// 单方向线性内存字节数 / 全部 8 方向合计字节数（DDR 占用规划用）
`define SBM_LM_BYTES_PER_ORI  (`SBM_T * `SBM_T * `SBM_CELLS)
`define SBM_LM_BYTES_TOTAL    (8 * `SBM_LM_BYTES_PER_ORI)

/// 位置总数上界：模板退化为 1 个 cell 时 template_positions 取最大值 CELLS。
/// alg11 按此上界分配通道容量，故任意模板尺寸都不会丢位置。
`define SBM_TP_MAX      `SBM_CELLS

`endif // SBM_GEOMETRY_VH
